# =================================================================
# NOVA PETZLIFE — Backend Environment Configuration Template
# Copy this file to .env and provide your actual secrets/keys
# NEVER commit .env to version control!
# =================================================================

# Server Port & Active Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration (Dedicated Application User: novapetz)
DB_NAME=nova_petzlife
DB_USERNAME=novapetz
DB_PASSWORD=replace_with_your_application_database_password
MYSQL_ROOT_PASSWORD=replace_with_your_mysql_root_password

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/nova_petzlife?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=novapetz
SPRING_DATASOURCE_PASSWORD=replace_with_your_application_database_password

# JWT Authentication (Minimum 256 bits / 32 characters)
JWT_SECRET=replace_with_your_secure_256_bit_jwt_secret_key_minimum_32_characters
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# Razorpay Payment Gateway (Test / Live Credentials)
RAZORPAY_KEY_ID=replace_with_your_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret

# Cloudinary / Image Storage
CLOUDINARY_CLOUD_NAME=novapetzlife
CLOUDINARY_API_KEY=replace_with_your_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_your_cloudinary_api_secret

# Google Maps & Google Places API
GOOGLE_MAPS_API_KEY=replace_with_your_google_maps_platform_api_key
GOOGLE_PLACE_ID=replace_with_your_google_place_id

# Mail / Notification Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications@novapetzlife.com
MAIL_PASSWORD=replace_with_your_email_app_password
MAIL_FROM=NOVA PETZLIFE <notifications@novapetzlife.com>
