# ==============================================================================
# NOVA PETZLIFE — Backend Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to .env and provide your actual secrets/keys.
# NEVER commit .env to version control!
# ==============================================================================

# Server Port & Active Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ==============================================================================
# OPTION A: LOCAL MYSQL DATABASE CONFIGURATION
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=nova_petzlife
DB_USERNAME=novapetz
DB_PASSWORD=replace_with_your_application_database_password
MYSQL_ROOT_PASSWORD=replace_with_your_mysql_root_password

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/nova_petzlife?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=novapetz
SPRING_DATASOURCE_PASSWORD=replace_with_your_application_database_password

# ==============================================================================
# OPTION B: REMOTE / PRODUCTION DATABASE CONFIGURATION (e.g. MonsterASP.net)
# ==============================================================================
# DB_HOST=db80963.public.databaseasp.net
# DB_PORT=3306
# DB_NAME=db80963
# DB_USERNAME=db80963
# DB_PASSWORD=replace_with_your_remote_database_password
# SPRING_DATASOURCE_URL=jdbc:mysql://db80963.public.databaseasp.net:3306/db80963?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
# SPRING_DATASOURCE_USERNAME=db80963
# SPRING_DATASOURCE_PASSWORD=replace_with_your_remote_database_password

# ==============================================================================
# 2. JWT Authentication & Security
# ==============================================================================
JWT_SECRET=replace_with_your_secure_256_bit_jwt_secret_key_minimum_32_characters
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ==============================================================================
# 3. CORS Allowed Origins
# ==============================================================================
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# ==============================================================================
# 4. Razorpay Payment Gateway
# ==============================================================================
RAZORPAY_KEY_ID=replace_with_your_razorpay_key_id
RAZORPAY_KEY_SECRET=replace_with_your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_your_razorpay_webhook_secret

# ==============================================================================
# 5. Media & Integrations
# ==============================================================================
CLOUDINARY_CLOUD_NAME=novapetzlife
CLOUDINARY_API_KEY=replace_with_your_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_your_cloudinary_api_secret
GOOGLE_MAPS_API_KEY=replace_with_your_google_maps_platform_api_key

# ==============================================================================
# 6. Temporary Gmail Apps Script Bridge (Password Reset Only)
# ==============================================================================
# RESEND_ENABLED=false
# RESEND_API_KEY=replace_with_your_resend_api_key
# RESEND_FROM_EMAIL=support@novapetzlife.com
# RESEND_FROM_NAME=NOVA PETZLIFE
GMAIL_BRIDGE_ENABLED=true
GMAIL_BRIDGE_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbyj72M-LJzlC2G4yogkhl7UhVD59PXmM24y9A3cp7C4Hl3J064gw-4BBs-AsX4jIztQIg/exec
GMAIL_BRIDGE_SECRET=
GMAIL_BRIDGE_FROM_NAME=NOVA PETZLIFE
CUSTOMER_FRONTEND_URL=http://localhost:4200
