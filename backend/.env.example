# =================================================================
# NOVA PETZLIFE — Backend Environment Configuration Template
# Copy this file to .env and provide your actual secrets/keys
# NEVER commit .env to version control!
# =================================================================

# Server Port & Active Profile
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/nova_petzlife?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# JWT Authentication
JWT_SECRET=your_base64_or_hex_encoded_secret_minimum_256_bits_length_here_must_be_very_secure
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201

# Razorpay Payment Gateway (Test / Live Credentials)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecretHere

# Cloudinary / Image Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Maps & Google Places API
GOOGLE_MAPS_API_KEY=your_google_maps_platform_api_key_here
GOOGLE_PLACE_ID=ChIJ_verified_petzlife_kuravankonam_place_id

# Mail / Notification Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications@novapetzlife.com
MAIL_PASSWORD=your_email_app_password
MAIL_FROM=NOVA PETZLIFE <notifications@novapetzlife.com>
