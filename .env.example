# ==============================================================================
# NOVA PETZLIFE — Production Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to `.env` in the project root and fill in the actual production
# secrets before launching with `docker-compose up -d`.
# NEVER commit the actual `.env` file containing live secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MySQL Database Configuration
# ------------------------------------------------------------------------------
DB_NAME=nova_petzlife
DB_USERNAME=novapetz
DB_PASSWORD=your_strong_production_db_password_here
DB_PORT=3306
MYSQL_ROOT_PASSWORD=your_strong_mysql_root_password_here

# ------------------------------------------------------------------------------
# 2. JWT Authentication & Security
# ------------------------------------------------------------------------------
# Base64 or 256-bit secret string (minimum 32 characters)
JWT_SECRET=your_secure_256_bit_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRATION_HOURS=24

# ------------------------------------------------------------------------------
# 3. Razorpay Payment Gateway Integration
# ------------------------------------------------------------------------------
# Obtain from Razorpay Dashboard (Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. Google Maps Platform & Places API
# ------------------------------------------------------------------------------
# Used for Kuravankonam listing verification and Places reviews sync
GOOGLE_MAPS_API_KEY=your_google_maps_platform_api_key_here

# ------------------------------------------------------------------------------
# 5. Media & Image CDN (Cloudinary)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=novapetzlife
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 6. CORS & Host Domains
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://novapetzlife.com,https://admin.novapetzlife.com,http://localhost:4200,http://localhost:4201

# ------------------------------------------------------------------------------
# 7. Store Profile (Petzlife, Kuravankonam)
# ------------------------------------------------------------------------------
STORE_NAME=NOVA PETZLIFE
STORE_ADDRESS=Petzlife, Kuravankonam Junction, Kuravankonam Ambalamukku Road
STORE_CITY=Thiruvananthapuram
STORE_STATE=Kerala
STORE_COUNTRY=India
STORE_PIN_CODE=695003
STORE_LATITUDE=8.528448
STORE_LONGITUDE=76.953268
STORE_DELIVERY_RADIUS_KM=20.0
